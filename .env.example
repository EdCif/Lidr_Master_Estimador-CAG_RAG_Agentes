# Copiar el archivo a .env y completar la clave API de OpenAI.
# Archivo Ejemplo.

APP_NAME="Estimador CAG"
APP_VERSION=0.1.0
APP_DEBUG=false

# Clave API de tu cuenta: introdúcela únicamente en tu .env local.
OPENAI_API_KEY=

# Opcional: cambia aquí el modelo predeterminado de config.py.
LLM_MODEL=gpt-4o-mini

# Sesión 2 · Clave de Anthropic para la interfaz Streamlit (Claude Sonnet 5 vía litellm).
# Introdúcela únicamente en tu .env local. Si queda vacía, la app FastAPI sigue funcionando.
ANTHROPIC_API_KEY=

# Carpeta local para guardar ideas, transcripciones e historial.
DATA_DIR=data

# Sesión 5 · Conversaciones con memoria y adjuntos (endpoints /sessions).
# Usan la misma ANTHROPIC_API_KEY de arriba. Todas son opcionales: si no las
# pones, se usan los valores de config.py que aparecen aquí.
SESSION_LLM_MODEL=claude-opus-5-5
SESSION_LLM_EFFORT=medium
# Camino de adjuntos por defecto: local (B, extracción de texto) o files_api (A).
ATTACHMENT_MODE=local
# Camino B: pypdf (rápido, PDF de texto) o markitdown (Markdown más estructurado).
PDF_EXTRACTOR=pypdf
MAX_ATTACHMENTS=5
MAX_ATTACHMENT_MB=10
# Topes que se comprueban antes de abrir cada fichero: páginas de un PDF y
# tamaño de un Word ya descomprimido (un .docx es un ZIP).
MAX_PDF_PAGES=300
MAX_DOCX_UNCOMPRESSED_MB=50
